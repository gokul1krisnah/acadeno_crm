rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'super_admin';
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        userRole() == 'super_admin' ||
        userRole() == 'admin'
      );
    }

    function isAdminOrManager() {
      return isSignedIn() && (
        isSuperAdmin() ||
        userRole() == 'manager' ||
        userRole() == 'team_lead' ||
        userRole() == 'operation manager' ||
        userRole() == 'operation_manager' ||
        userRole() == 'hr & operation manager' ||
        userRole() == 'hr_and_operation_manager'
      );
    }

    // -------------------------------------------------------------------------
    // Colleges Auto-Learning Collection (`colleges/{collegeId}`)
    // -------------------------------------------------------------------------
    match /colleges/{collegeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // Users Collection (`users/{userId}`)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // -------------------------------------------------------------------------
    // Leads Collection (`leads/{leadId}`) — PR-2.1 Row-Level Ownership
    // -------------------------------------------------------------------------
    match /leads/{leadId} {
      allow read: if isSignedIn() && (
        isAdminOrManager() ||
        resource.data.assignedToUid == request.auth.uid
      );
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrManager();
    }

    // -------------------------------------------------------------------------
    // Lead Assignments Collection (`lead_assignments/{assignmentId}`)
    // -------------------------------------------------------------------------
    match /lead_assignments/{assignmentId} {
      allow read, write: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // Assignments Collection (`assignments/{assignmentId}`)
    // -------------------------------------------------------------------------
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrManager();
    }

    // -------------------------------------------------------------------------
    // Alerts Collection (`alerts/{alertId}`)
    // -------------------------------------------------------------------------
    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdminOrManager();
    }

    // -------------------------------------------------------------------------
    // Notification Queue (`notification_queue/{queueId}`)
    // -------------------------------------------------------------------------
    match /notification_queue/{queueId} {
      allow read, write: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // College Visits Collection (`college_visits/{visitId}`)
    // -------------------------------------------------------------------------
    match /college_visits/{visitId} {
      allow read, write: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // Campaigns Collection (`campaigns/{campaignId}`)
    // -------------------------------------------------------------------------
    match /campaigns/{campaignId} {
      allow read, write: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // Phone Uniqueness Index (`lead_phones/{phone10}`)
    // -------------------------------------------------------------------------
    match /lead_phones/{phone10} {
      allow read, write: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // Permanent Call Logs (`call_logs/{logId}`) — FR-3.7 Append-Only
    // -------------------------------------------------------------------------
    match /call_logs/{logId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // Immutable Audit Log (`audit_log/{auditId}`) — PR-8.1 Append-Only
    // -------------------------------------------------------------------------
    match /audit_log/{auditId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
