rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // -------------------------------------------------------------------------
    // Colleges Auto-Learning Collection (`colleges/{collegeId}`)
    // -------------------------------------------------------------------------
    match /colleges/{collegeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // Users Collection (`users/{userId}`)
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // Leads Collection (`leads/{leadId}`)
    // -------------------------------------------------------------------------
    match /leads/{leadId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // Lead Assignments Collection (`lead_assignments/{assignmentId}`)
    // -------------------------------------------------------------------------
    match /lead_assignments/{assignmentId} {
      allow read, write: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // Assignments Collection (`assignments/{assignmentId}`)
    // -------------------------------------------------------------------------
    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // Alerts Collection (`alerts/{alertId}`)
    // -------------------------------------------------------------------------
    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // Notification Queue (`notification_queue/{queueId}`)
    // -------------------------------------------------------------------------
    match /notification_queue/{queueId} {
      allow read, write: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // College Visits Collection (`college_visits/{visitId}`)
    // -------------------------------------------------------------------------
    match /college_visits/{visitId} {
      allow read, write: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // Campaigns Collection (`campaigns/{campaignId}`)
    // -------------------------------------------------------------------------
    match /campaigns/{campaignId} {
      allow read, write: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // Phone Uniqueness Index (`lead_phones/{phone10}`)
    // -------------------------------------------------------------------------
    match /lead_phones/{phone10} {
      allow read, write: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // Permanent Call Logs (`call_logs/{logId}`)
    // -------------------------------------------------------------------------
    match /call_logs/{logId} {
      allow read, write: if isSignedIn();
    }

    // -------------------------------------------------------------------------
    // Immutable Audit Log (`audit_log/{auditId}`)
    // -------------------------------------------------------------------------
    match /audit_log/{auditId} {
      allow read, create: if isSignedIn();
      allow update, delete: if false;
    }
  }
}
